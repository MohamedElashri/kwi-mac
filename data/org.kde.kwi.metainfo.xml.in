-->
<component type="desktop-application">
  <id>@KWI_APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>@KWI_PROJECT_LICENSE@</project_license>
  <name>@KWI_DISPLAY_NAME@</name>
  <developer id="@KWI_APP_ID@"><name>Mohamed Elashri and contributors</name></developer>
  <summary>A fast terminal with bidirectional text support</summary>
  <description>
    <p>Zirq is an independently maintained terminal for macOS, based on KDE Kwi, with Arabic, Persian and Hebrew support.</p>
  </description>
  <url type="homepage">https://github.com/MohamedElashri/kwi-mac</url>
  <url type="vcs-browser">https://github.com/MohamedElashri/kwi-mac</url>
  <launchable type="desktop-id">@KWI_APP_ID@.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/MohamedElashri/kwi-mac/main/assets/readme/screenshot.png</image>
    </screenshot>
  </screenshots>
  <provides><binary>@KWI_EXECUTABLE@</binary></provides>
  <translation type="gettext">kwi</translation>
  <content_rating type="oars-1.1"/>
</component>
